  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "lib": ["ES2022"],
    "strict": true, "noUncheckedIndexedAccess": true, "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true, "types": [],
